# Copy to data/.env.local (gitignored) and fill in.
# Prefer this file for ACE experiments so peekorobo-api/.env (Neon) is not used.

# Local Postgres (native Windows install is fine)
# API reads DB_URL; pipeline reads DATABASE_URL — set both to the same local DSN.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/peekorobo_local
DB_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/peekorobo_local

# TBA keys still required for fetching matches during a local recompute
# TBA_API_KEYS=key1,key2

# Never set this for day-to-day local work
# ACE_ALLOW_PROD_WRITE=1
